        technological_tensor t 
    JOIN
        instance i 
            ON t.id_instance = i.id 
    WHERE
        i.popular_council_associated_with_committee_or_worker = ? 
        OR i.popular_council_associated_with_popular_council = ? 
    GROUP BY
        t.id_production_input,
        t.id_social_materialization
